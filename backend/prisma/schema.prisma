generator client {
  // Generador de Prisma Client para usarlo en Node.js
  provider = "prisma-client-js"
}

datasource db {
  // Motor actual de base de datos
  provider = "mysql"
}

// Estado generico para entidades simples (activo/inactivo)
enum RecordStatus {
  ACTIVE
  INACTIVE
}

// Estado de la organizacion/tenant
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

// Rol del usuario dentro de una organizacion
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// Estado de la membresia del usuario dentro de la organizacion
enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// Rol global de plataforma (acceso a secciones segun perfil)
enum UserRole {
  SUPER_ADMIN
  OWNER
  USER
}

// Estado de sesion/token
enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// Estado de negocio del caso (hoy en JSON era "lote")
enum CaseStatus {
  OPEN
  IN_REVIEW
  CLOSED
  ARCHIVED
}

// Tipo de documento extraido (hoy en JSON tipoDocumento)
enum DocumentType {
  MEDICAL_RECORD
  BILL
  OTHER
}

// Estado QA por documento
enum QaStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

// Estado del pendiente de revision
enum PendingReviewStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Tipo de job asyncrono de IA
enum AiJobType {
  EXTRACT
  QA_RUN
  QA_RESCAN
  NORMALIZE
}

// Estado del job asyncrono de IA
enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

// Usuario de la plataforma (login)
model User {
  // PK interna del usuario
  id           String        @id @default(cuid())
  // Email unico para login
  email        String        @unique @db.VarChar(191)
  // Password hasheado
  passwordHash String        @db.VarChar(255)
  // Rol global de plataforma para habilitar UI por perfil
  role         UserRole      @default(USER)
  // Nombre visible del usuario
  fullName     String?       @db.VarChar(191)
  // Estado de la cuenta
  status       RecordStatus  @default(ACTIVE)
  // Ultimo login exitoso
  lastLoginAt  DateTime?
  // Fecha de creacion
  createdAt    DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt    DateTime      @updatedAt

  // Organizaciones a las que pertenece
  memberships  Membership[]
  // Sesiones activas/historicas
  sessions     Session[]
  // Casos creados por este usuario
  createdCases CaseRecord[]  @relation("CaseCreatedBy")
  // Registros enviados a papelera por este usuario
  deletedTrash TrashItem[]   @relation("TrashDeletedBy")
  // Logs de auditoria disparados por este usuario
  auditLogs    AuditLog[]    @relation("AuditActor")

  // Nombre real de tabla en MySQL
  @@map("users")
}

// Tenant/cliente empresa (hoy tu data JSON quedaba mezclada en un solo archivo)
model Organization {
  // PK interna de la organizacion
  id                   String                @id @default(cuid())
  // Nombre de la organizacion
  name                 String                @db.VarChar(191)
  // Estado de la organizacion
  status               OrganizationStatus    @default(ACTIVE)
  // Fecha de creacion
  createdAt            DateTime              @default(now())
  // Fecha de ultima actualizacion
  updatedAt            DateTime              @updatedAt

  // Usuarios miembros de esta organizacion
  memberships          Membership[]
  // Features habilitadas para esta organizacion
  organizationFeatures OrganizationFeature[]
  // Casos/lotes de esta organizacion
  cases                CaseRecord[]
  // Documentos de esta organizacion
  documents            Document[]
  // Line items de documentos de esta organizacion
  lineItems            LineItem[]
  // Pendientes de revision de esta organizacion
  pendingReviews       PendingReview[]
  // Papelera de esta organizacion
  trashItems           TrashItem[]
  // Jobs de IA de esta organizacion
  aiJobs               AiJob[]
  // Trazas de IA de esta organizacion
  aiTraces             AiTrace[]
  // Auditoria de esta organizacion
  auditLogs            AuditLog[]

  // Nombre real de tabla en MySQL
  @@map("organizations")
}

// Relacion usuario-organizacion (multi-tenant membership)
model Membership {
  // PK interna de la membresia
  id             String           @id @default(cuid())
  // FK a organizacion
  organizationId String
  // FK a usuario
  userId         String
  // Rol del usuario en esa organizacion
  role           MembershipRole   @default(MEMBER)
  // Estado de la membresia
  status         MembershipStatus @default(ACTIVE)
  // Fecha de creacion
  createdAt      DateTime         @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime         @updatedAt

  // Navegacion a la organizacion
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion al usuario
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Evita doble membresia del mismo user en la misma org
  @@unique([organizationId, userId])
  // Indice para buscar organizaciones de un user
  @@index([userId])
  // Nombre real de tabla en MySQL
  @@map("organization_memberships")
}

// Catalogo de capacidades tecnicas del sistema (feature flags/entitlements)
model Feature {
  // PK interna de la feature
  id            String                @id @default(cuid())
  // Codigo unico tecnico (ej: extractor.qa.run)
  code          String                @unique @db.VarChar(191)
  // Nombre legible de la feature
  name          String                @db.VarChar(191)
  // Modulo funcional al que pertenece
  module        String                @db.VarChar(100)
  // Descripcion funcional
  description   String?               @db.VarChar(255)
  // Si la feature esta activa en catalogo
  isActive      Boolean               @default(true)
  // Fecha de creacion
  createdAt     DateTime              @default(now())
  // Fecha de ultima actualizacion
  updatedAt     DateTime              @updatedAt

  // Organizaciones que tienen esta feature configurada
  organizations OrganizationFeature[]

  // Nombre real de tabla en MySQL
  @@map("features")
}

// Habilitacion de feature por organizacion (hoy no habia esto en JSON)
model OrganizationFeature {
  // PK interna
  id             String        @id @default(cuid())
  // FK a organizacion
  organizationId String
  // FK a feature
  featureId      String
  // Feature habilitada o no para esta org
  isEnabled      Boolean       @default(true)
  // Inicio de vigencia de la habilitacion
  startsAt       DateTime?
  // Fin de vigencia (null = sin vencimiento)
  expiresAt      DateTime?
  // Fecha de creacion
  createdAt      DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime      @updatedAt

  // Navegacion a organizacion
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a feature
  feature        Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)

  // Evita duplicar la misma feature en la misma organizacion
  @@unique([organizationId, featureId])
  // Indice para listar orgs por feature
  @@index([featureId])
  // Nombre real de tabla en MySQL
  @@map("organization_features")
}

// Sesiones de autenticacion (refresh token o sesion persistente)
model Session {
  // PK interna
  id          String        @id @default(cuid())
  // FK al usuario
  userId      String
  // Hash unico del token
  tokenHash   String        @unique @db.VarChar(191)
  // IP origen de sesion
  ipAddress   String?       @db.VarChar(45)
  // User-Agent origen
  userAgent   String?       @db.VarChar(255)
  // Estado de la sesion
  status      SessionStatus @default(ACTIVE)
  // Fecha de expiracion
  expiresAt   DateTime
  // Fecha de revocacion manual
  revokedAt   DateTime?
  // Fecha de creacion
  createdAt   DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt   DateTime      @updatedAt

  // Navegacion al usuario
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indice para sesiones por usuario y estado
  @@index([userId, status])
  // Nombre real de tabla en MySQL
  @@map("sessions")
}

// Caso principal (equivale al lote del JSON actual)
model CaseRecord {
  // PK interna del caso
  id             String        @id @default(cuid())
  // FK al tenant dueño del caso
  organizationId String
  // Nombre oficial del cliente (hoy JSON: lote.nombre)
  clientName     String        @db.VarChar(191)
  // Date of Loss oficial (hoy JSON: lote.dol)
  dol            DateTime?
  // Estado del caso
  status         CaseStatus    @default(OPEN)
  // Usuario creador del caso
  createdById    String?
  // Fecha de creacion
  createdAt      DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime      @updatedAt

  // Navegacion a organizacion
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion al usuario que creo el caso
  createdBy      User?         @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Documentos asociados al caso
  documents      Document[]
  // Pendientes del caso (hoy JSON: lote.pendientes)
  pendingReviews PendingReview[]
  // Items en papelera asociados al caso
  trashItems     TrashItem[]
  // Jobs de IA disparados para el caso
  aiJobs         AiJob[]

  // Query principal: casos por org en timeline
  @@index([organizationId, createdAt])
  // Query por estado dentro de org
  @@index([organizationId, status, createdAt])
  // Query por DOL dentro de org
  @@index([organizationId, dol])
  // Nombre real de tabla en MySQL
  @@map("cases")
}

// Documento del caso (hoy en JSON estaba dentro de lote.documents)
model Document {
  // PK interna del documento
  id             String        @id @default(cuid())
  // FK al tenant dueño
  organizationId String
  // FK al caso/lote
  caseId         String
  // Nombre original del archivo
  originalName   String        @db.VarChar(255)
  // Clave de almacenamiento (ruta en disco hoy, S3 despues)
  storageKey     String        @db.VarChar(255)
  // MIME del archivo (pdf/png/jpg/etc)
  mimeType       String?       @db.VarChar(100)
  // Tipo de documento derivado por IA
  docType        DocumentType  @default(OTHER)
  // Quien envia/remitente detectado
  senderName     String?       @db.VarChar(191)
  // Estado QA del documento
  qaStatus       QaStatus      @default(PENDING)
  // Metadata variable (hoy varias banderas iban en JSON)
  metadata       Json?
  // Fecha de creacion
  createdAt      DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime      @updatedAt

  // Navegacion a organizacion
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a caso
  case           CaseRecord    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Lineas detalladas extraidas del documento
  lineItems      LineItem[]
  // Pendientes vinculados al documento (si aplica)
  pendingReviews PendingReview[]
  // Items en papelera vinculados al documento
  trashItems     TrashItem[]

  // Query principal de documentos por caso
  @@index([organizationId, caseId])
  // Query por estado QA
  @@index([organizationId, qaStatus])
  // Nombre real de tabla en MySQL
  @@map("documents")
}

// Detalle por linea del documento (hoy: lineItems dentro del objeto JSON)
model LineItem {
  // PK interna del line item
  id             String        @id @default(cuid())
  // FK al tenant dueño
  organizationId String
  // FK al documento padre
  documentId     String
  // Fecha de servicio
  serviceDate    DateTime?
  // Doctor asociado a la linea
  doctorName     String?       @db.VarChar(191)
  // Procedimiento asociado a la linea
  procedureName  String?       @db.VarChar(255)
  // Monto monetario (decimal exacto)
  amount         Decimal?      @db.Decimal(12, 2)
  // Payload crudo original para no perder contexto
  raw            Json?
  // Fecha de creacion
  createdAt      DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime      @updatedAt

  // Navegacion a organizacion
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a documento padre
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Query principal de line items por documento
  @@index([organizationId, documentId])
  // Nombre real de tabla en MySQL
  @@map("line_items")
}

// Cola de pendientes para revision humana/flujo QA (hoy JSON: lote.pendientes)
model PendingReview {
  // PK interna del pendiente
  id             String              @id @default(cuid())
  // FK al tenant dueño
  organizationId String
  // FK al caso/lote
  caseId         String
  // FK opcional al documento asociado
  documentId     String?
  // Motivo del pendiente (equivale a _pendienteMotivo)
  reason         String              @db.VarChar(255)
  // Data auxiliar del pendiente (diffs QA, etc)
  payload        Json?
  // Estado del pendiente
  status         PendingReviewStatus @default(OPEN)
  // Fecha de resolucion del pendiente
  resolvedAt     DateTime?
  // Fecha de creacion
  createdAt      DateTime            @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime            @updatedAt

  // Navegacion a organizacion
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a caso
  case           CaseRecord          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Navegacion a documento (si existe)
  document       Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // Query de pendientes abiertos por caso
  @@index([organizationId, caseId, status])
  // Nombre real de tabla en MySQL
  @@map("pending_reviews")
}

// Papelera de documentos/casos (hoy archivo deleted_records.json)
model TrashItem {
  // PK interna del item en papelera
  id             String        @id @default(cuid())
  // FK al tenant dueño
  organizationId String
  // FK opcional al caso relacionado
  caseId         String?
  // FK opcional al documento relacionado
  documentId     String?
  // Usuario que envio a papelera
  deletedById    String?
  // Fecha en que se envio a papelera
  deletedAt      DateTime      @default(now())
  // Fecha limite para restaurar
  restoreUntil   DateTime?
  // Snapshot completo del documento/caso borrado
  snapshot       Json
  // Fecha de creacion del registro
  createdAt      DateTime      @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime      @updatedAt

  // Navegacion a organizacion
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a caso (si sigue existiendo)
  case           CaseRecord?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  // Navegacion a documento (si sigue existiendo)
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // Navegacion al usuario que elimino
  deletedBy      User?         @relation("TrashDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Query de papelera por tenant y fecha
  @@index([organizationId, deletedAt])
  // Nombre real de tabla en MySQL
  @@map("trash_items")
}

// Job asyncrono de IA (reemplaza el flujo acoplado a request/respuesta)
model AiJob {
  // PK interna del job
  id             String      @id @default(cuid())
  // FK al tenant dueño
  organizationId String
  // FK opcional al caso sobre el que corre el job
  caseId         String?
  // Tipo de trabajo (extract, qa run, etc)
  type           AiJobType
  // Estado del job
  status         AiJobStatus @default(QUEUED)
  // Input del job
  payload        Json?
  // Resultado del job
  result         Json?
  // Intentos ejecutados
  attempts       Int         @default(0)
  // Maximo de intentos permitidos
  maxAttempts    Int         @default(3)
  // Ultimo error textual
  lastError      String?     @db.Text
  // Fecha de inicio real
  startedAt      DateTime?
  // Fecha de finalizacion real
  finishedAt     DateTime?
  // Fecha de creacion
  createdAt      DateTime    @default(now())
  // Fecha de ultima actualizacion
  updatedAt      DateTime    @updatedAt

  // Navegacion a organizacion
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a caso
  case           CaseRecord?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  // Traza detallada de pasos del job
  traces         AiTrace[]

  // Query de jobs por tenant y estado
  @@index([organizationId, status, createdAt])
  // Nombre real de tabla en MySQL
  @@map("ai_jobs")
}

// Log detallado de cada paso de un job de IA (timeline tecnico)
model AiTrace {
  // PK interna de la traza
  id             String       @id @default(cuid())
  // FK al job principal
  aiJobId        String
  // FK al tenant dueño
  organizationId String
  // Paso o etapa (ej: load_docs, model_call)
  step           String       @db.VarChar(120)
  // Mensaje legible del evento
  message        String       @db.Text
  // Data tecnica opcional del evento
  data           Json?
  // Fecha del evento
  createdAt      DateTime     @default(now())

  // Navegacion al job
  aiJob          AiJob        @relation(fields: [aiJobId], references: [id], onDelete: Cascade)
  // Navegacion a organizacion
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Query de trazas por job en orden temporal
  @@index([aiJobId, createdAt])
  // Query global de trazas por tenant
  @@index([organizationId, createdAt])
  // Nombre real de tabla en MySQL
  @@map("ai_traces")
}

// Auditoria funcional/seguridad (quien hizo que y cuando)
model AuditLog {
  // PK interna del log
  id             String       @id @default(cuid())
  // FK al tenant donde ocurrio la accion
  organizationId String
  // Usuario actor de la accion (nullable para eventos de sistema)
  actorUserId    String?
  // Accion ejecutada (ej: case.delete)
  action         String       @db.VarChar(120)
  // Tipo de entidad afectada (case, document, etc)
  entityType     String       @db.VarChar(120)
  // Id de entidad afectada
  entityId       String?      @db.VarChar(191)
  // Metadata variable del evento
  meta           Json?
  // Fecha del evento
  createdAt      DateTime     @default(now())

  // Navegacion a organizacion
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Navegacion a usuario actor
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Query cronologica de auditoria por tenant
  @@index([organizationId, createdAt])
  // Query por entidad especifica
  @@index([organizationId, entityType, entityId])
  // Nombre real de tabla en MySQL
  @@map("audit_logs")
}
